# ---------------------------------------------------------------------------
# Local authentik test stack - example configuration
# ---------------------------------------------------------------------------
#
#  !!  THROWAWAY CREDENTIALS  !!
#
#  Every secret in this file is a hard-coded, publicly-known placeholder for a
#  disposable container that lives for the length of a test run. They are
#  committed to git on purpose so CI needs no secret store.
#
#  NEVER reuse any of these values for an authentik instance that holds real
#  users, real data, or is reachable from anything but your laptop / the CI
#  runner. `down.sh` destroys the volumes; treat the whole stack as ephemeral.
#
# ---------------------------------------------------------------------------
#
# Usage:
#   cp .env.example .env        # then edit as needed
#   ./up.sh
#
# Precedence, highest first:
#   1. variables already exported in your shell
#   2. this directory's .env
#   3. the defaults baked into up.sh and docker-compose.yaml
#
# So `AUTHENTIK_TAG=2026.2.7 ./up.sh` wins over anything written here, which is
# how the CI version matrix drives the stack.
# ---------------------------------------------------------------------------


# --- authentik version ------------------------------------------------------

# Image repository. Rarely changed; exists so you can point at a local build or
# a mirror.
AUTHENTIK_IMAGE=ghcr.io/goauthentik/server

# Image tag. This is the knob the CI matrix turns. Must be one of the pinned
# tags in ../../supported-versions.yaml:
#   2026.8.2   (series 2026.8)
#   2026.5.7   (series 2026.5)
#   2026.2.7   (series 2026.2)
AUTHENTIK_TAG=2026.8.2


# --- bootstrap credentials --------------------------------------------------
# authentik reads these on its very first start and applies its bootstrap
# blueprint, creating the akadmin superuser plus a non-expiring API token whose
# key is AUTHENTIK_BOOTSTRAP_TOKEN verbatim. This is what lets CI authenticate
# without a human completing the browser setup flow.
#
# They only take effect on a fresh database. Change one and you must run
# ./down.sh (which wipes the volumes) before ./up.sh picks it up.

# The API token the operator and the E2E suite authenticate with:
#   Authorization: Bearer <AUTHENTIK_BOOTSTRAP_TOKEN>
AUTHENTIK_BOOTSTRAP_TOKEN=authentik-operator-e2e-bootstrap-token

# Password for akadmin, for logging into the admin UI while debugging.
AUTHENTIK_BOOTSTRAP_PASSWORD=authentik-operator-e2e-admin-password

# Email address for akadmin. Also the login identifier in the UI.
AUTHENTIK_BOOTSTRAP_EMAIL=akadmin@e2e.localhost


# --- authentik core ---------------------------------------------------------

# Django secret key. Signs sessions and tokens. Any non-empty string works for a
# disposable instance; generate a real one with `openssl rand -base64 60` if you
# ever keep this stack around.
AUTHENTIK_SECRET_KEY=insecure-local-test-secret-key-do-not-use-anywhere-else

# authentik log verbosity: trace | debug | info | warning | error
# Bump to debug when a readiness timeout needs diagnosing.
AUTHENTIK_LOG_LEVEL=info


# --- host networking --------------------------------------------------------

# Host port mapped to the server container's HTTP listener (9000 inside).
# The API base URL therefore becomes http://localhost:${AUTHENTIK_HOST_PORT}
# Change it if something else on your machine already owns 9000.
AUTHENTIK_HOST_PORT=9000

# Host port mapped to the server container's HTTPS listener (9443 inside).
# The E2E suite uses plain HTTP; this is exposed only for manual poking.
AUTHENTIK_HOST_PORT_HTTPS=9443


# --- PostgreSQL -------------------------------------------------------------

POSTGRES_IMAGE=docker.io/library/postgres:16-alpine
PG_DB=authentik
PG_USER=authentik
PG_PASS=insecure-local-test-password


# --- readiness gate ---------------------------------------------------------

# How long up.sh waits for an authenticated API call to succeed, in seconds.
# First boot runs the full Django migration set plus blueprint import, so this
# needs real headroom - a suite that races authentik's migrations fails
# intermittently, which is worse than failing outright.
AUTHENTIK_READY_TIMEOUT=600

# Seconds between readiness probes.
AUTHENTIK_READY_INTERVAL=3


# --- compose ----------------------------------------------------------------

# Compose project name. Prefixes container and volume names, and is what
# down.sh targets when removing volumes. Change it to run two stacks side by
# side (also change AUTHENTIK_HOST_PORT).
COMPOSE_PROJECT_NAME=authentik-operator-test


# --- legacy ----------------------------------------------------------------

# authentik removed its Redis dependency in 2025.10; cache, channel layer and
# task broker all live in PostgreSQL now, and none of the supported versions
# reference Redis at all. The compose file still defines a redis service under
# the `legacy-redis` profile for anyone pointing this stack at an older image.
# To use it, start with `docker compose --profile legacy-redis up -d` and
# uncomment:
# REDIS_IMAGE=docker.io/library/redis:alpine
# AUTHENTIK_REDIS__HOST=redis
